<%- include("partials/header") %>

<section class="page-header">
  <h2>Editar unidade <%= unidade.numero %></h2>
  <p><%= empreendimento ? empreendimento.nome : 'Empreendimento não encontrado' %></p>
</section>

<% if (erro) { %>
  <div class="empty-state" style="color:#b91c1c;background:#fef2f2;border:1px solid #fecaca;margin-bottom:16px;">
    <%= erro %>
  </div>
<% } %>

<section class="form-card">
  <form action="/unidades/<%= unidade.id %>" method="POST">
    <div class="form-grid">
      <div class="form-group">
        <label for="numero">Número</label>
        <input type="text" id="numero" name="numero" value="<%= unidade.numero %>" required />
        <small>É por este número que o formulário encontra a unidade.</small>
      </div>

      <div class="form-group">
        <label for="pavimento">Pavimento</label>
        <input type="text" id="pavimento" name="pavimento" value="<%= unidade.pavimento || '' %>" />
      </div>

      <div class="form-group">
        <label for="tipologia">Tipologia</label>
        <input type="text" id="tipologia" name="tipologia" value="<%= unidade.tipologia || '' %>" />
      </div>

      <div class="form-group">
        <label for="metragem">Metragem</label>
        <input type="text" id="metragem" name="metragem" value="<%= unidade.metragem || '' %>" />
      </div>

      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <% Object.entries(statusMap).forEach(([v, r]) => { %>
            <option value="<%= v %>" <%= unidade.status === v ? 'selected' : '' %>><%= r %></option>
          <% }) %>
        </select>
        <small>Voltar para “Livre” desfaz o vínculo com o cliente.</small>
      </div>
    </div>


    <h3 style="margin-top:26px;">Dados para o contrato</h3>
    <p style="color:#6b7280;font-size:14px;margin-top:-8px;">
      Cadastre uma vez. O formulário de contrato traz estes dados já preenchidos, em vez de
      pedi-los de novo a cada venda.
    </p>
    <div class="form-grid">
      <div class="form-group">
        <label for="tipoImovel">Tipo do imóvel</label>
        <input type="text" id="tipoImovel" name="tipoImovel" value="<%= unidade.tipoImovel || '' %>" placeholder="apartamento" />
        <small>Como o contrato chama a unidade: apartamento, cobertura, sala comercial…</small>
      </div>
      <div class="form-group">
        <label for="vagasGaragem">Vagas de garagem</label>
        <input type="text" id="vagasGaragem" name="vagasGaragem" value="<%= unidade.vagasGaragem || '' %>" placeholder="1" />
      </div>
      <div class="form-group">
        <label for="numerosVagas">Números das vagas</label>
        <input type="text" id="numerosVagas" name="numerosVagas" value="<%= unidade.numerosVagas || '' %>" placeholder="12 e 13" />
      </div>
      <div class="form-group">
        <label for="areaPrivativa">Área privativa (m²)</label>
        <input type="text" id="areaPrivativa" name="areaPrivativa" value="<%= unidade.areaPrivativa || '' %>" placeholder="93,89" />
      </div>
      <div class="form-group">
        <label for="areaConstrucao">Área de construção (m²)</label>
        <input type="text" id="areaConstrucao" name="areaConstrucao" value="<%= unidade.areaConstrucao || '' %>" placeholder="108,60" />
      </div>
      <div class="form-group">
        <label for="fracaoIdeal">Fração ideal</label>
        <input type="text" id="fracaoIdeal" name="fracaoIdeal" value="<%= unidade.fracaoIdeal || '' %>" placeholder="0,0179" />
      </div>
      <div class="form-group full">
        <label for="descricaoPlanta">Descrição da planta</label>
        <input type="text" id="descricaoPlanta" name="descricaoPlanta" value="<%= unidade.descricaoPlanta || '' %>"
               placeholder="3 quartos, 1 suíte, varanda gourmet" />
      </div>
    </div>

    <div class="actions" style="margin-top:16px;">
      <button type="submit" class="button">Salvar alterações</button>
      <a class="button secondary" href="/empreendimentos/<%= unidade.empreendimentoId %>">Cancelar</a>
    </div>
  </form>
</section>

<%- include("partials/footer") %>
