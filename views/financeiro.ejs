<%- include("partials/header") %>

<% 
  const real = (v) => 'R$ ' + Number(v || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const cores = {
    previsto: ['#fffbeb', '#92400e', '#fde68a'],
    atrasado: ['#fef2f2', '#b91c1c', '#fecaca'],
    recebido: ['#f0fdf4', '#166534', '#bbf7d0'],
    cancelado: ['#f8fafc', '#64748b', '#e2e8f0']
  };
  // Situação desconhecida não pode derrubar a página inteira.
  const cor = (s) => cores[s] || ['#ffffff', '#374151', '#e5e7eb'];
%>

<div class="container">
  <div class="page-header">
    <h2>Financeiro</h2>
    <p>Recebimentos por empreendimento, unidade e cliente. Apenas valores confirmados entram no total recebido.</p>
  </div>

  <% if (erro) { %>
    <div style="background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
      <%= erro %>
    </div>
  <% } %>

  <div class="cards">
    <div class="card">
      <p>Recebido</p>
      <div class="big-number" style="color: #15803d;"><%= real(totais.recebido) %></div>
      <p class="mini-stats">Confirmado em caixa</p>
    </div>
    <div class="card">
      <p>A vencer</p>
      <div class="big-number" style="color: #1d4ed8;"><%= real(totais.aVencer) %></div>
      <p class="mini-stats">Ainda dentro do prazo</p>
    </div>
    <div class="card">
      <p>Atrasado</p>
      <div class="big-number" style="color: #b91c1c;"><%= real(totais.atrasado) %></div>
      <p class="mini-stats">Venceu e não foi pago</p>
    </div>
  </div>

  <div class="form-card">
    <form method="GET" action="/financeiro" class="inline-form">
      <div class="form-grid" style="grid-template-columns: 1fr 1fr; margin-bottom: 0;">
        <div class="form-group">
          <label>Empreendimento</label>
          <select name="empreendimento" onchange="this.form.submit()">
            <option value="todos" <%= empreendimentoSelecionado === "todos" ? "selected" : "" %>>Todos</option>
            <% empreendimentos.forEach(e => { %>
              <option value="<%= e.id %>" <%= empreendimentoSelecionado === e.id ? "selected" : "" %>><%= e.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Situação</label>
          <select name="situacao" onchange="this.form.submit()">
            <option value="todas" <%= situacaoSelecionada === 'todas' ? 'selected' : '' %>>Todas</option>
            <option value="atrasado" <%= situacaoSelecionada === 'atrasado' ? 'selected' : '' %>>Atrasadas (<%= contagem.atrasado %>)</option>
            <option value="previsto" <%= situacaoSelecionada === 'previsto' ? 'selected' : '' %>>A vencer (<%= contagem.previsto %>)</option>
            <option value="recebido" <%= situacaoSelecionada === 'recebido' ? 'selected' : '' %>>Confirmadas (<%= contagem.recebido %>)</option>
            <% if (contagem.cancelado) { %>
              <%# Só aparece quando existe: operação distratada deixa parcelas aqui %>
              <option value="cancelado" <%= situacaoSelecionada === 'cancelado' ? 'selected' : '' %>>Canceladas (<%= contagem.cancelado %>)</option>
            <% } %>
          </select>
        </div>
      </div>
    </form>
  </div>

  <div class="form-card">
    <h3>Novo lançamento manual</h3>
    <p style="color: #6b7280; font-size: 14px; margin-top: -10px; margin-bottom: 20px;">Use para registrar entradas avulsas e aportes que não dependem diretamente de contratos.</p>
    
    <form method="POST" action="/financeiro">
      <input type="hidden" name="tipo" value="entrada"> <!-- Força tipo entrada implicitamente -->
      <div class="form-grid">
        <div class="form-group">
          <label>Empreendimento</label>
          <select name="empreendimentoId">
            <option value="">Não vinculado</option>
            <% empreendimentos.forEach(e => { %>
              <option value="<%= e.id %>" <%= empreendimentoSelecionado === e.id ? 'selected' : '' %>><%= e.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Unidade</label>
          <select name="unidadeId">
            <option value="">Não vinculada</option>
            <%
              // Agrupado por empreendimento: a mesma numeração se repete entre
              // torres, então o número sozinho seria ambíguo na hora de escolher.
              let grupoAtual = null;
              unidades.forEach(u => {
                if (u.empreendimentoNome !== grupoAtual) {
                  if (grupoAtual !== null) { %></optgroup><% }
                  grupoAtual = u.empreendimentoNome; %>
                  <optgroup label="<%= grupoAtual %>">
                <% }
            %>
              <option value="<%= u.id %>">Unidade <%= u.numero %></option>
            <% });
              if (grupoAtual !== null) { %></optgroup><% }
            %>
          </select>
        </div>
        <div class="form-group">
          <label>Cliente</label>
          <select name="clienteId">
            <option value="">Usar o cliente da unidade</option>
            <% clientes.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.nome %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Categoria</label>
          <input type="text" name="categoria" placeholder="Ex: Sinal, Balão, Aporte" required>
        </div>
        <div class="form-group">
          <label>Valor (R$)</label>
          <input type="text" name="valor" placeholder="0.000,00" required>
        </div>
        <div class="form-group">
          <label>Vencimento</label>
          <input type="date" name="data" required>
        </div>
        <div class="form-group">
          <label>Situação inicial</label>
          <select name="status">
            <option value="recebido">Já recebido (Confirmado)</option>
            <option value="previsto" selected>A vencer (Pendente)</option>
          </select>
        </div>
        <div class="form-group full">
          <label>Observação</label>
          <input type="text" name="observacao" placeholder="Detalhes adicionais...">
        </div>
      </div>
      <div class="actions" style="margin-top: 20px;">
        <button type="submit" class="button">Salvar lançamento</button>
      </div>
    </form>
  </div>

  <% if (financeiro.length === 0) { %>
    <div class="empty-state">
      Nenhum recebimento registrado para este filtro.
    </div>
  <% } else { %>
    <table style="margin-top: 24px;">
      <thead>
        <tr>
          <th>Vencimento</th>
          <th>Empreendimento</th>
          <th>Unidade</th>
          <th>Cliente</th>
          <th>Categoria</th>
          <th>Valor</th>
          <th>Situação</th>
          <th>Observação</th>
          <th style="text-align: right;">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% financeiro.forEach(item => { %>
          <% const [bg, fg, bd] = cor(item.situacao); %>
          <tr style="background-color: <%= bg %>;">
            <td><%= item.data || '—' %></td>
            <td><%= item.empreendimentoNome %></td>
            <%# O cabeçalho já diz "Unidade": repetir na célula só quebraria a linha %>
            <td style="white-space: nowrap;"><%= item.unidadeNumero || '—' %></td>
            <td><%= item.clienteNome || '—' %></td>
            <td><%= item.categoria %></td>
            <td style="font-weight: bold;"><%= real(item.valor) %></td>
            <td>
              <span style="color: <%= fg %>; font-weight: bold; background: <%= bd %>; padding: 4px 8px; border-radius: 6px; font-size: 12px;">
                <%= item.situacaoLabel %>
                <% if (item.situacao === 'recebido' && item.dataRecebimento) { %>
                  em <%= item.dataRecebimento %>
                <% } %>
              </span>
            </td>
            <td><%= item.observacao || '' %></td>
            <td>
              <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <% if (item.situacao === 'recebido') { %>
                  <form method="POST" action="/financeiro/<%= item.id %>/desfazer" style="display: inline;">
                    <input type="hidden" name="empreendimento" value="<%= empreendimentoSelecionado %>">
                    <button type="submit" class="button secondary" style="padding: 6px 10px; font-size: 12px;">Desfazer recebimento</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/financeiro/<%= item.id %>/receber" style="display: inline;">
                    <input type="hidden" name="empreendimento" value="<%= empreendimentoSelecionado %>">
                    <button type="submit" class="button" style="padding: 6px 10px; font-size: 12px; background-color: #16a34a;">Confirmar</button>
                  </form>
                <% } %>
                <form method="POST" action="/financeiro/<%= item.id %>/excluir" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja excluir?')">
                  <input type="hidden" name="empreendimento" value="<%= empreendimentoSelecionado %>">
                  <button type="submit" class="button danger" style="padding: 6px 10px; font-size: 12px;">Excluir</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("partials/footer") %>